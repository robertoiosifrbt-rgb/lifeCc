{
  "name": "life-control-centre",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "session:start": "node scripts/session-start.mjs",
    "branch:guard": "node scripts/branch-guard.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "check:structure": "node scripts/check-structure.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:rls": "node scripts/check-rls.mjs",
    "check:cycle": "node scripts/check-cycle.mjs",
    "check": "node scripts/check.mjs",
    "check:reachable": "node scripts/check-reachable.mjs",
    "check:drops": "node scripts/check-drops.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
